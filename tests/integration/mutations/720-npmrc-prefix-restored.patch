# case: 720-node-multiversion-nvm-use
# what: /etc/skel/.npmrc is re-baked with prefix=${HOME}/.ai-tools/npm -- the exact
#       regression that broke `nvm use`. nvm's nvm_die_on_prefix check fails `nvm use
#       <version>` outright (not a warning) whenever $HOME/.npmrc sets a prefix, so the
#       node=22,20 multi-version workflow breaks the instant ~/.ai-tools is populated.
#
diff --git a/Dockerfile b/Dockerfile
--- a/Dockerfile
+++ b/Dockerfile
@@ -956,7 +956,8 @@
 # refuses the name too. `if`, not `&&`, so sourcing the file under dash still
 # returns 0. Case 310 runs both, and tests/test-profile-scripts.sh runs the
 # lines below under dash, bash and posix-mode bash.
-RUN install -d /etc/skel/.local/bin && \
+RUN printf 'prefix=${HOME}/.ai-tools/npm\n' > /etc/skel/.npmrc && \
+    install -d /etc/skel/.local/bin && \
     printf '%s\n' \
       'export UV_TOOL_DIR="$HOME/.ai-tools/uv"' \
       'export UV_TOOL_BIN_DIR="$HOME/.ai-tools/uv/bin"' \
