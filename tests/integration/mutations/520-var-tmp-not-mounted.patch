# case: 520-agent-files-persist-across-restart
# what: the group's temp volume is never mounted over /var/tmp, so the agent's temp files vanish with the container
#
diff --git a/sandbox.sh b/sandbox.sh
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -8688,3 +8688,2 @@
   vartmp_vol="$(vartmp_volume_ensure "$group")" || exit 1
-  config_mount_flags+=(-v "$vartmp_vol:/var/tmp")
   # The bind version's folder is never mounted, copied or removed here: named,
