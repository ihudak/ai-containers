# case: 455-launcher-dir-nested-mount
# what: the directories between a mount root and a launcher are no longer bound
#       onto themselves, so under a parent mount they are ordinary directories
#       again: renamable, with the read-only overlay moving along with them. The
#       overlays themselves are untouched.
#
#       Expected: "the directory above the launcher cannot be moved" FAILs. Both
#       launchers still read and refuse writes, and the parent and project stay
#       writable; a FAIL there first would mean the case measures something
#       other than the pinning.
#
diff --git a/sandbox.sh b/sandbox.sh
index 4785435..41ccd67 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -331,7 +331,7 @@ launcher_ro_overlay() {
       path="$path/$part"; at="$at/$part"
       [[ -n "${seen[$at]:-}" ]] && continue
       seen[$at]=1
-      _ro+=(--mount "type=bind,source=$path,destination=$at")
+      :
     done
     at="$dst/$rel"
     [[ -n "${seen[$at]:-}" ]] && continue
