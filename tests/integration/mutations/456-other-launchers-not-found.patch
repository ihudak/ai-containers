# what: launcher_dirs_in finds nothing, so only this launcher's own directory is
#       protected, and every other launcher inside the same writable mount is
#       as writable as the mount around it.
#
#       Expected: "agent cannot write" FAILs for /workspace/grp/other/.ai-containers
#       and /workspace/grp/odd,name/.ai-containers. This launcher's own overlay,
#       the pinning and every writability control still PASS.
#
diff --git a/sandbox.sh b/sandbox.sh
index c7e0532..79c62b5 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -416,7 +416,7 @@ launcher_dirs_in() {
       \( -name node_modules -o -name .git -o -name vendor -o -name .venv -o -name target \) -prune \
       -o -type f -name sandbox.sh -print0 2>/dev/null)
   for f in ${hits[@]+"${hits[@]}"}; do
-    if [[ -f "${f%/sandbox.sh}/sandbox-common.sh" ]]; then _ldi_out+=("${f%/sandbox.sh}"); fi
