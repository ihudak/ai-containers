# case: 455-launcher-dir-nested-mount
# what: launcher_dirs_in finds nothing, so only this launcher's own directory is
#       protected — the state before the review — and another project's launcher
#       inside the same writable mount is as writable as the mount around it.
#
#       Expected: "agent cannot write: /workspace/grp/other/.ai-containers"
#       FAILs. This launcher's own overlay, the pinning and every writability
#       control still PASS.
#
diff --git a/sandbox.sh b/sandbox.sh
index 4785435..17d4c1b 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -362,7 +362,7 @@ launcher_dirs_in() {
   local f d
   while IFS= read -r f; do
     d="${f%/sandbox.sh}"
-    [[ -f "$d/sandbox-common.sh" ]] && printf '%s\n' "$d"
+    false && printf '%s\n' "$d"
   done < <(find "$1" -mindepth 1 -maxdepth 7 \
              \( -name node_modules -o -name .git -o -name vendor -o -name .venv -o -name target \) -prune \
              -o -type f -name sandbox.sh -print 2>/dev/null)
