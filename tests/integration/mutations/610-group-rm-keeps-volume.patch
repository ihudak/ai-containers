# case: 610-group-rm-removes-both
# what: group.sh rm deletes the directory but skips the volume, orphaning it
#
diff --git a/group.sh b/group.sh
--- a/group.sh
+++ b/group.sh
@@ -412,7 +412,7 @@
   local failed=0
   for k in ruby temp; do
     [[ "${act[$k]}" == remove ]] || continue
-    if docker volume rm "${vol[$k]}" >/dev/null 2>&1; then
+    if true; then # MUTATION: volume removal skipped
       printf 'Removed volume %s\n' "${vol[$k]}"
     else
       printf 'WARNING: could not remove volume %s — leaving the directory in place.\n' "${vol[$k]}" >&2
