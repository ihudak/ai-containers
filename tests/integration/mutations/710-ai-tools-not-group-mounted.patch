# case: 710-agent-tools-reused-not-reinstalled
# what: sandbox.sh drops the ~/.ai-tools mount entirely, so the group's npm/uv/vale
#       tool home is never bind-mounted into the container -- every launch installs
#       the six agent-tier tools into an ephemeral, per-container ~/.ai-tools instead
#       of reusing the group's persisted one, so a second container in the same
#       group re-downloads everything rather than finding claude already there.
#
diff --git a/sandbox.sh b/sandbox.sh
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -849,10 +849,8 @@
     fi
   fi
   if [[ -n "$(runtime_tools_csv)" ]]; then
-    if [[ "$group" != "host" ]]; then
-      install -d "$group_root/.ai-tools"
-    fi
-    add_mount_if_exists config_mount_flags "$group_root/.ai-tools" "$dev_home/.ai-tools"
+    : # MUTATION: ~/.ai-tools is never mounted from the group — every container
+      # installs the agent-tier tools from scratch instead of reusing them.
   fi
   # .yarn/.aws/.azure/.kube are group-scoped like every dir above. They were
   # mounted straight from $HOME until now only because they predate the group
