# case: 455-launcher-dir-nested-mount
# what: what a launcher's symlinks point at is no longer collected, so the link
#       itself is read-only with the launcher while its target — the file the
#       host actually reads — is as writable as the directory around it: the
#       state before the review that found it.
#
#       Expected: "agent cannot change what a launcher's symlink points at" and
#       "the host's linked file is unchanged" FAIL. Every launcher overlay,
#       the pinning and the writability controls (shared/ included) still PASS.
#
diff --git a/sandbox.sh b/sandbox.sh
index 9daa36e..577f177 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -428,7 +428,7 @@ launcher_ro_overlay() {
         elif [[ "$tgt" == "$src"/* ]]; then at="$dst/${tgt#"$src"/}"
         else continue; fi
         d="${at//[!\/]/}"
-        cl+=("$tgt"); cat+=("$at"); csrc+=("$src"); cdst+=("$dst"); cdep+=("${#d}"); ckind+=(linked)
+        :
         if (( ${#d} > max )); then max=${#d}; fi
       done
       if [[ -d "$tgt" && -z "${queued[$tgt]:-}" ]]; then queued[$tgt]=1; queue+=("$tgt"); fi
