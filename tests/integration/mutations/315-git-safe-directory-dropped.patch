# case: 315-git-trusts-unowned-repo
# what: the entrypoint no longer trusts every repository in the sandbox user's
#       git config, so git refuses a repository whose directory the running
#       uid does not own -- every host bind on Colima, where a mount root shows
#       as owned by root.
#
#       Expected: "the sandbox user runs git in a repository root owns" FAILs
#       with "detected dubious ownership".
#
#       NEEDS A REBUILD. entrypoint.sh is copied into the image; see
#       310-make-not-installed.patch for why --reuse-image would test an image
#       that predates it.
#
--- a/entrypoint.sh
+++ b/entrypoint.sh
@@ -220,7 +220,6 @@
   find "$home_dir" -xdev -exec chown "$uid:$gid" {} + 2>/dev/null || true
 
   sandbox_user="$(getent passwd "$uid" | cut -d: -f1)"
-  trust_repositories_for_sandbox_user
 }
 
 # git refuses a repository another user owns ("detected dubious ownership"), and
