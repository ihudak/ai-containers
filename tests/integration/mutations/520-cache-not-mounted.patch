# case: 520-agent-files-persist-across-restart
# what: the group's .cache is never mounted over ~/.cache, so tool caches vanish with the container
#
diff --git a/sandbox.sh b/sandbox.sh
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -8731,3 +8731,2 @@
   install -d "$group_root/.cache" "$group_root/.local/state"
-  add_mount_if_exists config_mount_flags "$group_root/.cache" "$dev_home/.cache"
   add_mount_if_exists config_mount_flags "$group_root/.local/state" "$dev_home/.local/state"
