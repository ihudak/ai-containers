# case: 610-group-rm-removes-both
# what: group.sh rm removes the directory and the Ruby and temp volumes but leaves the group's cache volume orphaned: 'assert_volume_absent <cache volume>' goes red
#
diff --git a/group.sh b/group.sh
index 06ef698..a3421f9 100755
--- a/group.sh
+++ b/group.sh
@@ -527,7 +527,7 @@ cmd_rm() {
   # Every volume is tried; one docker would not remove keeps the directory, whose
   # removal would orphan it.
   local failed=0
-  for k in ruby temp cache; do
+  for k in ruby temp; do # MUTATION: the cache volume is never removed
     [[ "${act[$k]}" == remove ]] || continue
     if docker volume rm "${vol[$k]}" >/dev/null 2>&1; then
       printf 'Removed volume %s\n' "${vol[$k]}"
