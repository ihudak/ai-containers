# case: 740-ruby-bootstraps-and-resolves
# what: link-default-ruby.sh links the default Ruby's binstubs onto /usr/local/bin
#       but stops there -- it neither exposes ruby_executable_hooks nor falls back
#       to rvm's own wrappers. This is the state the file shipped in before those
#       two blocks were added, and the defect they were added for: rvm rewrites gem
#       binstub shebangs to `#!/usr/bin/env ruby_executable_hooks`, and a
#       non-interactive, non-login shell has neither ~/.rvm/bin nor the @global
#       gemset bin dir on PATH. So `bundle` and `bundler` RESOLVE (they are on
#       PATH, symlinked correctly) and then die on exec with
#         /usr/bin/env: 'ruby_executable_hooks': No such file or directory
#       while plain ruby/gem/rake/irb/erb -- no rewritten shebang -- keep working.
#
#       This is the ONLY mutation that drives assert_runs' "present but FAILED TO
#       RUN" branch end to end against a real rvm binstub. That branch has hermetic
#       vector coverage in tests/test-integration-lib.sh, but hermetic vectors prove
#       the logic, not that a real container can produce the state. Its predecessor
#       in verify-on-host.sh was unreachable for its entire existence, so "on PATH"
#       and "runs" being genuinely different outcomes is exactly what needs proving.
#
#       Expected: 740's assert_runs for `bundle` and `bundler` report
#       "is present but FAILED TO RUN" with the shebang in the diagnostic dump;
#       ruby/gem/rake/irb/erb still PASS. A case that goes wholly red here has
#       found something else.
#
diff --git a/link-default-ruby.sh b/link-default-ruby.sh
index 8772720..f5a3422 100755
--- a/link-default-ruby.sh
+++ b/link-default-ruby.sh
@@ -50,44 +50,3 @@ for b in ruby gem bundle bundler rake irb erb; do
   fi
 done
 log "linked default Ruby from $bindir into $bin_dest: ${linked:-none}"
-
-# rvm rewrites gem binstub shebangs to `#!/usr/bin/env ruby_executable_hooks` (the
-# executable-hooks gem, installed into the @global gemset). A non-login shell has
-# neither ~/.rvm/bin nor the gemset bin dir on PATH, so linking the binstub alone
-# left `bundle` resolving but dying with
-#   /usr/bin/env: 'ruby_executable_hooks': No such file or directory
-# while plain `ruby`/`gem` (no rewritten shebang) worked — which is why this only
-# showed up once the bootstrap itself started succeeding. Expose the hook too.
-hook=""
-for cand in "$rvm_root/bin/ruby_executable_hooks" "$rvm_root"/gems/*@global/bin/ruby_executable_hooks \
-            "$rvm_root"/gems/*/bin/ruby_executable_hooks; do
-  if [[ -x "$cand" ]]; then hook="$cand"; break; fi
-done
-if [[ -n "$hook" ]]; then
-  ln -sf "$hook" "$bin_dest/ruby_executable_hooks"
-  log "linked ruby_executable_hooks from $hook"
-fi
-
-# Verify each link actually RUNS, and fall back to rvm's own wrapper for any that
-# does not. wrappers/<ruby>/ is generated by the gem-wrappers gem for precisely this
-# case — each wrapper sets GEM_HOME/GEM_PATH/PATH and then execs — so it works
-# without rvm being sourced, at the cost of a bash process per call. Preferring the
-# direct binstub and falling back only on failure keeps the fast path fast and stops
-# a silently broken `bundle` from reaching a caller.
-wrapdir=""
-for cand in "$rvm_root/wrappers/default" "$rvm_root"/wrappers/ruby-*; do
-  if [[ -d "$cand" ]]; then wrapdir="$cand"; break; fi
-done
-if [[ -n "$wrapdir" ]]; then
-  repaired=""
-  for b in $linked; do
-    "$bin_dest/$b" --version >/dev/null 2>&1 && continue
-    if [[ -x "$wrapdir/$b" ]]; then
-      ln -sf "$wrapdir/$b" "$bin_dest/$b"
-      repaired="${repaired:+$repaired }$b"
-    else
-      log "WARNING: $b does not run and $wrapdir/$b is not available to fall back to"
-    fi
-  done
-  [[ -n "$repaired" ]] && log "re-pointed at rvm wrappers (direct binstub would not run): $repaired"
-fi
