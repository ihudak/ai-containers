# case: 430-blocked-output-reaches-host
# what: the .agent-blocked host bind is removed, so capture output is written only inside the container
#
diff --git a/sandbox.sh b/sandbox.sh
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -2772,6 +2772,7 @@
       exit 1
     fi
     mkdir -p "$launch_dir/$_od"
+    [[ "$_od" == .agent-blocked ]] && continue # MUTATION: host bind for .agent-blocked removed
     output_mount_flags+=(-v "$launch_dir/$_od:/workspace/$_od"); output_dirs+=("$_od")
   done
   [[ "$mode" != discovery ]] || capture_enabled="1"
