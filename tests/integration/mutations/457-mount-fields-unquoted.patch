# case: 455-launcher-dir-nested-mount
# what: the --mount value is no longer CSV-quoted. docker reads it as a CSV
#       record, so the comma in /workspace/grp/c:o,n (a name with a ':', hence
#       handed over as --mount) splits a field and docker refuses the whole
#       `docker run`: one directory name an agent can create, and every later
#       launch fails until someone finds it on the host.
#
#       Expected: launcher_up FAILs — sandbox.sh exits 125 with docker's
#       "invalid field ... must be a key=value pair" in the launch log — and the
#       case ends there.
#
diff --git a/sandbox.sh b/sandbox.sh
index 7261e57..28619d1 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -442,7 +442,7 @@ _bind_mount_arg() {
   else
     if [[ "$5" == ro ]]; then o=",readonly"; fi
     printf -v "$1" '%s' --mount
-    printf -v "$2" 'type=bind,"%s","%s"%s' "${s//\"/\"\"}" "${d//\"/\"\"}" "$o"
+    printf -v "$2" 'type=bind,%s,%s%s' "$s" "$d" "$o"
   fi
 }
 
