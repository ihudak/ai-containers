# case: 465-git-internals-read-only
# what: hooks/ and config are read-only and .git is pinned, but no commondir
#       placeholder is made, so the agent can create .git/commondir — which git
#       reads in ANY git directory — and point the host's git at a config and
#       hooks of its own. The bypass the overlay alone left open.
#
#       Expected: "the agent cannot write .git/commondir" and "the host's git
#       still takes its config and hooks from .git itself" FAIL. The hook,
#       config and rename assertions still PASS: everything else is intact.
diff --git a/sandbox.sh b/sandbox.sh
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -882,7 +882,7 @@
           if [[ ! -e "$g/hooks" && ! -L "$g/hooks" ]]; then mkdir "$g/hooks" 2>/dev/null || _git_cant_make "$g" hooks; fi
           first=""
           if [[ ! -e "$g/commondir" && ! -L "$g/commondir" ]]; then
-            if ( set -C; printf './\n' > "$g/commondir" ) 2>/dev/null; then first=1; else _git_cant_make "$g" commondir; fi
+            :
           fi
           # Anything but our ./ sends the host's git elsewhere for this repository's
           # configuration and hooks, and git never writes one here: refuse, rather
