# case: 455-launcher-dir-nested-mount
# what: a launcher link whose way out leads into a writable mount is no longer
#       warned about — the launch is silent while the agent can change what the
#       host reads through proj/.ai-containers/linked.conf (shared/linked.conf):
#       the state before the reviews that found it.
#
#       Expected: "a launcher link into a writable directory is warned about,
#       naming its target" FAILs. Every overlay, the pinning and every
#       writability control still PASS.
#
diff --git a/sandbox.sh b/sandbox.sh
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -1294,7 +1294,7 @@
       # directory, say) stays home — read-only with the launcher, or the working
       # dir someone is deliberately editing.
       if ! _walk_exposed how q w "$x" ${walk[@]+"${walk[@]}"}; then continue; fi
-      printf 'WARNING: launcher link %s leads somewhere the agent can change:\n' "$(_term "$f")" >&2
+      continue
       case "$how" in
         change)  printf '         it can change %s (at %s), which the host reads through it.\n' "$(_term "$q")" "$(_term "$w")" >&2 ;;
         linked)  printf '         it can write %s through another name of that file, in %s\n' "$(_term "$q")" "$(_term "$w")" >&2
