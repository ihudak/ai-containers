# case: 520-agent-files-persist-across-restart
# what: /var/tmp is the old host bind again, not the group's volume: the 'is the group's Docker volume' docker-inspect assertion goes red (the tar check stays green on Linux, where a bind holds the links; it can go red only on a Mac)
#
diff --git a/sandbox.sh b/sandbox.sh
index c0f8c3a..72b2d3c 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -8686,7 +8686,8 @@ run_container() {
   # knows a temp volume by its label, would never take it for the group's.
   local vartmp_vol
   vartmp_vol="$(vartmp_volume_ensure "$group")" || exit 1
-  config_mount_flags+=(-v "$vartmp_vol:/var/tmp")
+  install -d "$group_root/.var-tmp" # MUTATION: the old host folder is mounted instead of the volume
+  config_mount_flags+=(-v "$group_root/.var-tmp:/var/tmp")
   # The bind version's folder is never mounted, copied or removed here: named,
   # with how to copy it into the volume and how to remove it, at every launch
   # while it is there.
