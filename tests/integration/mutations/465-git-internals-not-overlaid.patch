# case: 465-git-internals-read-only
# what: the launcher never looks for git directories, so .git is exactly as
#       writable as the project around it: every launch before this change.
#
#       Expected: "the agent cannot write .git/hooks/pre-commit", "the host has
#       no pre-commit hook", "the agent cannot change .git/config", "the agent
#       cannot write .git/commondir" and "the host's git still takes its config
#       and hooks from .git itself" FAIL, and so do both rename assertions
#       (nothing is mounted on .git). The
#       project's writability and the agent's commit still PASS; a FAIL there
#       first would mean the case measures something other than the overlay.
diff --git a/sandbox.sh b/sandbox.sh
index f58cd5a..aed38ed 100755
--- a/sandbox.sh
+++ b/sandbox.sh
@@ -691,7 +691,7 @@ launcher_ro_overlay() {
       printf '      your host'\''s git may run what changes there.\n' >&2
     fi
     gdirs=(); gfiles=(); glinks=(); gunr=()
-    git_dirs_in gdirs gfiles glinks gunr "$src"
+    :
     _git_scan_srcs+=("$src"); _git_bsrc=(${bsrc[@]+"${bsrc[@]}"})
     for f in ${gdirs[@]+"${gdirs[@]}"} ${gfiles[@]+"${gfiles[@]}"} ${glinks[@]+"${glinks[@]}"} ${gunr[@]+"${gunr[@]}"}; do
       _git_launch_seen[$f]="$(_git_ident "$f")"
