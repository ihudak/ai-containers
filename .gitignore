/.idea/
/.remember/

# Personal/local Claude Code settings (a shared .claude/settings.json may still be committed)
.claude/settings.local.json

# Editor swap/temp files
*.swp
*.swo
.DS_Store

# Agent outputs written to the launch directory by sandbox.sh (restricted/discovery).
.agent-blocked/
.agent-discovery/

# verify-on-host.sh run logs. Machine-specific output (host paths, UID/GID, the
# local Docker/Colima state), regenerated on every run and useful only for the
# run that produced it. ai-containers-host-verify.log was tracked for a while,
# which made every host verification dirty the working tree and invited pasting
# one machine's output over another's.
/ai-containers-host-verify.log
/phase4.log
*-host-verify.log

# Generated by build.sh — edit the *.d/ fragment directories instead
/allowlist-domains.txt
/allowlist-proxy-domains.txt
/allowlist-cidrs.txt

# User-specific custom allowlist entries — may contain internal hostnames.
# Copy the .example files to get started:
#   cp allowlist-domains.d/custom.txt.example allowlist-domains.d/custom.txt
#   cp allowlist-proxy-domains.d/custom.txt.example allowlist-proxy-domains.d/custom.txt
#   cp allowlist-cidrs.d/custom.txt.example allowlist-cidrs.d/custom.txt
allowlist-domains.d/custom.txt
allowlist-proxy-domains.d/custom.txt
allowlist-cidrs.d/custom.txt

# Project registry — populated by project-init.sh. Gitignored to avoid
# committing personal paths. See projects.conf.example for the format.
/projects.conf

# The synced working copy project-init.sh puts beside a project — including this
# repo, when it is registered against itself. project-init.sh writes exactly this
# line into every project it initialises; this repo never got it, and was relying
# on a `.ai-containers/` line in the DEVELOPER'S global gitignore instead.
# Without that global line, `git ls-files --others --exclude-standard '*.sh'`
# lists 22 working-copy scripts here, so verify-on-host.sh Phase 7 lints a copy
# of the engine as of whatever release it last synced — which can fail on rules
# added since. Green in CI, which has no working copy; red on the machine that
# actually runs containers. Same shape as the sweep exclusion in
# tests/test-sourced-guards.sh, through the other door.
/.ai-containers/


# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# mutate.sh state marker (which known-bad patch is currently applied)
/tests/integration/mutations/.applied

# script(1)'s default output file. Given no file argument it writes `typescript`
# in the CURRENT directory — which is how an empty one reached the repo root in
# the v0.9.6 review commit, from a bare `script` run while testing p_pty.
#
# THE SECOND HALF OF THIS NOTE WAS WRONG AND IS CORRECTED RATHER THAN DELETED.
# It said "BSD `script --version` names no file, so it opens this and execs an
# interactive shell", which was DERIVED from `mktemp --tmpdir` exiting 0 on BSD
# and never executed. Measured on macOS 26.6.2 the next day: BSD script REJECTS
# `--version` at getopt (rc 1, "illegal option -- -"), creates no file and execs
# nothing. The `--`-prefixed-argument behaviour is per-utility, not a property
# of BSD getopt, so one measured utility licenses no conclusion about another.
#
# The line still earns its place, and so does the probe change it describes:
# tests/portability.sh passes `-q /dev/null` so no BSD variant CAN write one,
# and tests/test-portability.sh asserts that sourcing it creates no file in the
# cwd — but neither stops a stray one being COMMITTED, which is what this is for.
/typescript
